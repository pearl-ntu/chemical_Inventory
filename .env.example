# ---------------------------------------------------------------------------
# PEARL Inventory — environment configuration
#
# Copy this file to `.env` and fill in the two values from your Supabase
# project (Project Settings -> API). Both are *public* client-side keys and are
# safe to expose in a browser build: the database is protected by Row Level
# Security policies, not by key secrecy. Never put the `service_role` key here.
#
# Leave these blank (or delete .env) to run the app in DEMO MODE, which uses
# the browser's local storage and needs no server at all.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: restrict sign-ups to your institution. Comma-separated list of
# allowed email domains. Leave blank to allow any address.
VITE_ALLOWED_EMAIL_DOMAINS=e.ntu.edu.sg,ntu.edu.sg

# Optional: shown in the app header.
VITE_LAB_NAME=PEARL Group
VITE_LAB_SUBTITLE=Prof. Xiaogang Liu Lab · NTU Singapore
